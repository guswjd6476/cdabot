# 운영 서버 웹훅 주소 (예: https://계정명.alwaysdata.net/cdabot/webhook) — 비우면 로컬 폴링 모드
WEBHOOK_URL=
# 크론 주소 보호용 비밀값 (설정 시 /cron-10pm?key=값 형태로 호출)
CRON_SECRET=
PORT=8301
