# 새 봇 토큰 (@BotFather에서 새로 발급 — counseling-bot 토큰과 다른 것)
TELEGRAM_BOT_TOKEN=
# counseling-bot과 같은 Neon DB 주소
NEON_DATABASE_URL=
# 관리자 텔레그램 ID (쉼표 구분) — 봇에게 /내아이디 로 확인
