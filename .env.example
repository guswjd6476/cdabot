# 새 봇 토큰 (@BotFather에서 새로 발급 — counseling-bot 토큰과 다른 것)
TELEGRAM_BOT_TOKEN=
# counseling-bot과 같은 Neon DB 주소
NEON_DATABASE_URL=
# 관리자 텔레그램 ID (쉼표 구분) — 봇에게 /내아이디 로 확인
ADMIN_IDS=
# 운영 서버 웹훅 주소 (예: https://도메인/webhook) — 비우면 로컬 폴링 모드
WEBHOOK_URL=
# 크론 주소 보호용 비밀값 (설정 시 /cron-10am?key=값 형태로 호출)
CRON_SECRET=
# maeum(코칭존)이 고쳐 올린 누적 결과지를 읽는 /board 비밀값 (maeum CDABOT_BOARD_SECRET 과 같게, 비우면 /board 막힘)
BOARD_SECRET=
